# Optional OpenRouter fallback
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Agent control plane. For local MLX, API_KEY is only a placeholder and the
# model value is the downloaded model directory (absolute paths are safest).
AGENTIC_BASE_URL=http://127.0.0.1:8080
AGENTIC_API_KEY=local
AGENTIC_PLANNER_MODEL=/absolute/path/to/adityaDdon/models/Qwen3.5-9B-4bit
AGENTIC_CONFIDENCE_THRESHOLD=0.92
AGENTIC_MAX_STEPS=2
AGENTIC_TIMEOUT_SECONDS=240
AGENTIC_API_RETRIES=0
AGENTIC_BATCH_SIZE=8

# Dual-architecture agreement ensemble. Only disagreements reach the model;
# switching away from the stable incumbent requires two high-confidence votes.
ENSEMBLE_BATCH_SIZE=8
ENSEMBLE_SWITCH_CONFIDENCE=0.92
ENSEMBLE_CORROBORATED_CONFIDENCE=0.85
ENSEMBLE_RERANKER_MIN_SCORE=0.90
ENSEMBLE_RERANKER_MIN_MARGIN=0.25

# Experimental only. The blind semantic-hybrid candidate regressed relative
# to the protected typed-ensemble baseline, so embeddings/reranking may run
# only when explicitly opted in for shadow evaluation.
SEMANTIC_OVERRIDES_ENABLED=0

# Offline two-stage semantic retrieval. Exact IDs and graph edges always have
# precedence. Dense candidates must compile through the typed tool boundary.
EMBEDDING_MODEL_PATH=/absolute/path/to/adityaDdon/models/Qwen3-Embedding-0.6B
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSIONS=1024
EMBEDDING_RECALL_MIN_SCORE=0.55
EMBEDDING_CHALLENGE_MIN_SCORE=0.64
EMBEDDING_CHALLENGE_MIN_MARGIN=0.08
RERANKER_MODEL_PATH=/absolute/path/to/adityaDdon/models/Qwen3-Reranker-0.6B
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
